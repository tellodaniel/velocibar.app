      "`engine` \\(el motor usado\\)",
      "with these columns:",
      "con estas columnas:",
      "\\(date, time, download_mbps, latency_ms\\)"
    ],
    "must_match": []
  },
  {
    "claim": "Minimum macOS is 26",
    "paths": [
