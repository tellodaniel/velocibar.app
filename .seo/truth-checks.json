      "upload_mbps"
    ],
    "must_match": [],
    "_note": "Other tools' upload readouts may be described; VelociBar itself never measures upload."
  },
  {
    "claim": "The CSV engine column is named source, not engine, and the file has more columns than the five shown",
    "paths": [
      "index.md",
      "en/index.md",
      "llms.txt",
      "llms-full.txt",
      "blog/**/*.html",
      "blog/**/*.md",
      "en/blog/**/*.html",
      "en/blog/**/*.md"
    ],
    "must_not_match": [
      "`engine`, `download_mbps`",
      "<code>engine</code>, <code>download_mbps</code>",
